# Browser-visible values. Never place service-role or Stripe secret keys here.
VITE_APP_URL=https://example.de
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
VITE_GOOGLE_MAPS_BROWSER_KEY=replace_with_referrer_restricted_key
VITE_TURNSTILE_SITE_KEY=replace_with_cloudflare_turnstile_site_key
VITE_PLAUSIBLE_DOMAIN=example.de
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

# Required legal identity for a German production build. Have counsel approve it.
VITE_LEGAL_COMPANY_NAME=Example Mobility
VITE_LEGAL_FORM=GmbH
VITE_LEGAL_MANAGING_DIRECTOR=Max Beispiel
VITE_LEGAL_STREET=Beispielstraße 1
VITE_LEGAL_POSTCODE=10115
VITE_LEGAL_CITY=Berlin
VITE_LEGAL_PHONE=+49 30 000000
VITE_LEGAL_EMAIL=legal@example.de
VITE_LEGAL_REGISTER_COURT=Amtsgericht Berlin-Charlottenburg
VITE_LEGAL_REGISTER_NUMBER=HRB 000000 B
VITE_LEGAL_VAT_ID=DE000000000
VITE_LEGAL_CONTENT_RESPONSIBLE=Max Beispiel, Beispielstraße 1, 10115 Berlin

# Configure these with `supabase secrets set`; they are not Vite variables.
# APP_URL, ALLOWED_ORIGINS, SUPABASE_URL, SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# STRIPE_PRICE_DEALER,
# CRON_SECRET, DMS_CREDENTIAL_ENCRYPTION_KEY, GOOGLE_MAPS_API_KEY,
# AI_API_URL, AI_API_KEY, AI_MODEL
