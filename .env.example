# ─────────────────────────────────────────────────────────────
# Zivvo — Environment Variables (example)
# Copy to .env and fill with real values. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── Supabase (public/publishable — safe for browser bundle) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ── App URL (used for SEO canonical, OG, sitemap) ──
VITE_APP_URL=https://zivvo.de

# ── Legal identity (Impressum — §5 TMG) ──
VITE_LEGAL_COMPANY_NAME=
VITE_LEGAL_FORM=
VITE_LEGAL_MANAGING_DIRECTOR=
VITE_LEGAL_STREET=
VITE_LEGAL_POSTCODE=
VITE_LEGAL_CITY=
VITE_LEGAL_PHONE=
VITE_LEGAL_EMAIL=
VITE_LEGAL_REGISTER_COURT=
VITE_LEGAL_REGISTER_NUMBER=
VITE_LEGAL_VAT_ID=
VITE_LEGAL_CONTENT_RESPONSIBLE=

# ── Google Maps (browser key — restrict by HTTP referrer) ──
VITE_GOOGLE_MAPS_BROWSER_KEY=

# ── Analytics (optional — Plausible) ──
VITE_PLAUSIBLE_DOMAIN=zivvo.de
VITE_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# ── Advertising (optional — AdSense / Media.net) ──
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
