{
  "name": "zivvo-marketplace",
  "private": true,
  "version": "1.2.0-rc.2",
  "type": "module",
  "scripts": {
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:production": "node scripts/validate-production-env.mjs && vite build --mode production && node scripts/verify-production-artifact.mjs",
    "check": "npm run check:repo && npm run check:workflows && npm run check:public-claims && npm run check:edge-security && npm run check:native && npm run test:production-config && npm run test:release-contract && npm run test:smoke-contract && npm run test:sbom-contract && npm run test:production-gate && npm run typecheck && npm run lint && npm run test && npm run build",
    "check:edge-security": "node scripts/check-edge-security.mjs",
    "check:native": "node scripts/check-native-config.mjs",
    "check:public-claims": "node scripts/check-public-claims.mjs",
    "check:repo": "node scripts/check-repository-hygiene.mjs",
    "check:workflows": "node scripts/check-workflow-security.mjs",
    "dev": "vite",
    "lint": "eslint .",
    "native:doctor": "npx cap doctor",
    "native:links": "node scripts/generate-native-links.mjs",
    "native:sync": "npm run build && npx cap sync",
    "preview": "vite preview",
    "release:evidence": "node scripts/create-release-evidence.mjs",
    "release:evidence:verify": "node scripts/verify-release-evidence.mjs",
    "release:production-gate": "node scripts/verify-production-candidate.mjs",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "release:sbom:verify": "node scripts/verify-sbom.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:production-config": "node scripts/test-production-env.mjs",
    "test:production-gate": "node scripts/test-production-gate.mjs",
    "test:release-contract": "node scripts/test-release-contract.mjs",
    "test:sbom-contract": "node scripts/test-sbom.mjs",
    "test:smoke-contract": "node scripts/test-smoke-production.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
